# En desarrollo (junto a Vite) usa MASSMAIL_API_PORT; en produccion basta con
# PORT (la mayoria de los hostings Node, como cPanel, ya la inyectan solos).
MASSMAIL_API_PORT=3001
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string

# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 10))"
APP_PASSWORD_HASH=

# Alternativa mas simple (sin hash) si preferis no generar el hash:
# APP_PASSWORD=tu-contraseña

# Asistente de ayuda con IA (boton flotante). Gratis: genera una key en
# https://aistudio.google.com/apikey. Si se deja vacio, el boton muestra
# un aviso de que el asistente no esta configurado.
GEMINI_API_KEY=

# Persistencia de datos (cuentas, plantillas, listas, campanas) via Supabase.
# Project URL y service_role key (Settings > API > Legacy anon, service_role
# API keys) del proyecto de Supabase que se use. La service_role key bypassea
# RLS -- nunca exponerla al frontend, solo vive en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
